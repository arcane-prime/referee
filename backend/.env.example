DATA_DIR=data
MAX_UPLOAD_BYTES=52428800
CORS_ORIGINS=["http://localhost:3000"]

# ---------------------------------------------------------------- Parsing
GROBID_URL=https://kermitt2-grobid.hf.space
GROBID_TIMEOUT_SECONDS=180

# ---------------------------------------------------------------- Resolution
OPENALEX_MAILTO=you@example.com
SEMANTIC_SCHOLAR_API_KEY=
SEARCH_TIMEOUT_SECONDS=20
RESOLUTION_CONCURRENCY=3
SEARCH_FALLBACK_ENABLED=true
VERIFICATION_BUDGET_SECONDS=75

# ---------------------------------------------------------------- Review
OPENAI_API_KEY=
REVIEW_MODEL=gpt-4.1-mini
REVIEW_TIMEOUT_SECONDS=90
REVIEW_CONCURRENCY=12

# ---------------------------------------------------------------- Caching
HTTP_CACHE_ENABLED=true
HTTP_CACHE_TTL_HOURS=720
