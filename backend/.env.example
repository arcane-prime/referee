DATA_DIR=data
MAX_UPLOAD_BYTES=52428800
CORS_ORIGINS=["http://localhost:3000"]

# ---------------------------------------------------------------- Parsing
GROBID_URL=https://kermitt2-grobid.hf.space
GROBID_TIMEOUT_SECONDS=180

# ---------------------------------------------------------------- Resolution
OPENALEX_MAILTO=you@example.com
SEMANTIC_SCHOLAR_API_KEY=
SEARCH_TIMEOUT_SECONDS=20
RESOLUTION_CONCURRENCY=3
SEARCH_FALLBACK_ENABLED=true
VERIFICATION_BUDGET_SECONDS=75

# ---------------------------------------------------------------- Review
CEREBRAS_API_KEY=
REVIEW_MODEL=gpt-oss-120b
REVIEW_TIMEOUT_SECONDS=90
REVIEW_CONCURRENCY=4

# ---------------------------------------------------------------- Caching
HTTP_CACHE_ENABLED=true
HTTP_CACHE_TTL_HOURS=720

# Notes
#
# Every value here matches the default in app/core/config.py, so an empty .env
# and this file describe the same system. Copy it to .env and change only what
# you need.
#
# CEREBRAS_API_KEY is the only variable without a usable default. Without it
# extraction and resolution work normally and the review step reports that the
# model is unreachable, rather than the app failing to start.
#
# OPENALEX_MAILTO is optional but worth setting: it opts into OpenAlex's polite
# pool, which is faster and more reliable, and it is the courteous way to use a
# free public service at roughly forty requests per paper.
#
# GROBID_URL points at the public hosted instance so extraction works with no
# local infrastructure. It is shared and rate limited. Point it at a local
# container with GROBID_URL=http://localhost:8070 and no code changes.
